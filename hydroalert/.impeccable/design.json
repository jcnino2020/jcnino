  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary run and local-save commands.",
      "html": "<button class=\"ds-btn ds-primary\" type=\"button\">Run scenario</button>",
      "css": ".ds-btn{min-height:44px;border:1px solid var(--line,#d1dbd5);border-radius:var(--radius,4px);background:var(--surface,#ffffff);color:var(--ink,#20352c);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;font:600 14px/1.4 var(--font,\"Public Sans\",sans-serif);letter-spacing:0;cursor:pointer}.ds-btn:hover{background:var(--green-soft,#e2eee7)}.ds-btn:focus-visible{outline:3px solid var(--water,#17659b);outline-offset:3px}.ds-btn:disabled{cursor:not-allowed;opacity:.6}.ds-primary{background:var(--forest,#154c3b);border-color:var(--forest,#154c3b);color:#fff}.ds-primary:hover{background:var(--forest-hover,#22644e)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet route and supporting commands.",
      "html": "<button class=\"ds-btn\" type=\"button\">Monitoring view</button>",
      "css": ".ds-btn{min-height:44px;border:1px solid var(--line,#d1dbd5);border-radius:var(--radius,4px);background:var(--surface,#ffffff);color:var(--ink,#20352c);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;font:600 14px/1.4 var(--font,\"Public Sans\",sans-serif);letter-spacing:0;cursor:pointer}.ds-btn:hover{background:var(--green-soft,#e2eee7)}.ds-btn:focus-visible{outline:3px solid var(--water,#17659b);outline-offset:3px}.ds-btn:disabled{cursor:not-allowed;opacity:.6}"
    },
    {
      "name": "Destructive Confirmation",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Local high-water confirmation and clear-all decisions.",
      "html": "<button class=\"ds-btn ds-red\" type=\"button\">Clear local records</button>",
      "css": ".ds-btn{min-height:44px;border:1px solid var(--line,#d1dbd5);border-radius:var(--radius,4px);background:var(--surface,#ffffff);color:var(--ink,#20352c);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;font:600 14px/1.4 var(--font,\"Public Sans\",sans-serif);letter-spacing:0;cursor:pointer}.ds-btn:hover{background:var(--green-soft,#e2eee7)}.ds-btn:focus-visible{outline:3px solid var(--water,#17659b);outline-offset:3px}.ds-btn:disabled{cursor:not-allowed;opacity:.6}.ds-red{background:var(--red-soft,#fbe9e7);color:var(--red,#ac3035);border-color:var(--red,#ac3035)}.ds-red:hover{background:var(--green-soft,#e2eee7)}"
    },
    {
      "name": "Observation Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and native measurement control.",
      "html": "<div class=\"ds-field\"><label for=\"ds-level\">Water level (m, optional)</label><input id=\"ds-level\" type=\"number\" min=\"0\" max=\"20\" step=\"0.01\" placeholder=\"e.g. 1.20\"></div>",
      "css": ".ds-field{font:400 15px/1.6 var(--font,\"Public Sans\",sans-serif);color:var(--ink,#20352c);letter-spacing:0}.ds-field label{font-size:13px;font-weight:600;display:block;margin-bottom:8px}.ds-field input{width:100%;border:1px solid var(--line,#d1dbd5);border-radius:var(--radius,4px);background:var(--surface,#ffffff);padding:11px 12px;min-height:44px;color:var(--ink,#20352c);caret-color:var(--forest,#154c3b);font:inherit;letter-spacing:0}.ds-field input::placeholder{color:var(--muted,#58665e);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--water,#17659b);outline-offset:3px}"
    },
    {
      "name": "Route Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Persistent route names in the forest header.",
      "html": "<nav class=\"ds-nav\" aria-label=\"HydroAlert views\"><a href=\"/hydroalert/\" aria-current=\"page\">Monitoring</a><a href=\"/hydroalert/resident.html\">Community</a><a href=\"/hydroalert/mobile/\">Field reports</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;background:var(--forest,#154c3b);padding:14px;font-family:var(--font,\"Public Sans\",sans-serif)}.ds-nav a{min-height:44px;display:flex;align-items:center;gap:8px;padding:11px 16px;color:#d1e5da;text-decoration:none;font-size:14px;border-radius:var(--radius,4px);letter-spacing:0}.ds-nav a:hover{background:var(--forest-hover,#22644e);color:#fff}.ds-nav a[aria-current=page]{background:#fff;color:var(--forest,#154c3b);font-weight:600}.ds-nav a:focus-visible{outline:3px solid #fff;outline-offset:3px}@media(max-width:760px){.ds-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.ds-nav a{padding:10px 5px;font-size:12px;justify-content:center;gap:7px}}"
    },
    {
      "name": "Labeled Severity",
      "kind": "chip",
      "refersTo": "status",
      "description": "Text-plus-dot routine, rising and high-water states.",
      "html": "<div class=\"ds-states\"><span class=\"ds-status\">Routine</span><span class=\"ds-status\" data-severity=\"rising\">Rising</span><span class=\"ds-status\" data-severity=\"high\">High water</span></div>",
      "css": ".ds-states{display:flex;flex-wrap:wrap;gap:16px}.ds-status{display:inline-flex;align-items:center;gap:6px;font:600 12px/1.6 var(--font,\"Public Sans\",sans-serif);letter-spacing:0;white-space:nowrap;color:var(--green,#236248)}.ds-status::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}.ds-status[data-severity=rising]{color:var(--amber,#8b530b)}.ds-status[data-severity=high]{color:var(--red,#ac3035)}"
    },
    {
      "name": "Station Row",
      "kind": "custom",
      "refersTo": "station-selected",
      "description": "Flat selected station with a wrapping value and explicit state.",
      "html": "<button class=\"ds-station\" type=\"button\" aria-pressed=\"true\"><span><strong>Minoyan</strong><small>Murcia / Upstream</small></span><span class=\"ds-bottom\"><span class=\"ds-value\">1.2 m</span><span class=\"ds-status\">Routine</span></span></button>",
      "css": ".ds-station{border:0;border-bottom:1px solid var(--line,#d1dbd5);width:100%;padding:18px 20px;background:var(--surface,#ffffff);color:var(--ink,#20352c);text-align:left;display:grid;gap:10px;cursor:pointer;font:400 15px/1.6 var(--font,\"Public Sans\",sans-serif);letter-spacing:0}.ds-station:hover{background:var(--ground,#f2f5f3)}.ds-station[aria-pressed=true]{background:var(--green-soft,#e2eee7)}.ds-station:focus-visible{outline:3px solid var(--water,#17659b);outline-offset:3px}.ds-station strong{font-size:15px;display:block;font-weight:700}.ds-station small{display:block;color:var(--muted,#58665e);font-size:12px}.ds-bottom{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.ds-value{font:600 20px/1.6 var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-variant-numeric:tabular-nums}.ds-status{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;white-space:nowrap;color:var(--green,#236248)}.ds-status::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}@media(max-width:760px){.ds-station{padding:14px 12px}.ds-station strong{font-size:13px}.ds-station small,.ds-status{font-size:11px}.ds-value{font-size:18px}}"
    },
    {
      "name": "Example Advisory",
      "kind": "custom",
      "refersTo": "advisory",
      "description": "Flat tonal advisory that maintains the example boundary.",
      "html": "<section class=\"ds-advisory\" data-severity=\"rising\"><span class=\"ds-status\">Downstream rise example</span><h2>Downstream water is rising in this scenario.</h2><p>The synthetic downstream level has increased. For actual warnings, consult official sources and local authorities.</p></section>",
      "css": ".ds-advisory{background:var(--green-soft,#e2eee7);padding:28px;color:var(--ink,#20352c);font:400 15px/1.6 var(--font,\"Public Sans\",sans-serif);letter-spacing:0}.ds-advisory[data-severity=rising]{background:var(--amber-soft,#fff0cf)}.ds-advisory[data-severity=high]{background:var(--red-soft,#fbe9e7)}.ds-advisory h2{font-size:27px;font-weight:600;line-height:1.25;margin:16px 0 0;text-wrap:balance}.ds-advisory p{margin:12px 0 0;color:var(--muted,#58665e);font-size:14px;max-width:70ch}.ds-status{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;white-space:nowrap;color:var(--amber,#8b530b)}.ds-status::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}@media(max-width:760px){.ds-advisory{padding:22px 20px}.ds-advisory h2{font-size:24px}}"
    },
    {
      "name": "Scenario Stages",
      "kind": "custom",
      "description": "Native radio group for manual demonstration stages.",
      "html": "<fieldset class=\"ds-scenarios\"><legend class=\"ds-hidden\">Demonstration scenario stage</legend><label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-scenario\" checked><span>Baseline</span></label><label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-scenario\"><span>Upstream rain</span></label><label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-scenario\"><span>Downstream rise</span></label><label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-scenario\"><span>High water</span></label></fieldset>",
      "css": ".ds-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.ds-scenarios{display:flex;flex-wrap:wrap;gap:0;border:1px solid var(--line,#d1dbd5);padding:0;margin:0;border-radius:var(--radius,4px);min-width:0;font:400 15px/1.6 var(--font,\"Public Sans\",sans-serif);letter-spacing:0}.ds-scenarios label{cursor:pointer;display:block}.ds-scenarios span{padding:11px 16px;min-height:44px;display:block;color:var(--muted,#58665e);background:var(--surface,#ffffff)}.ds-scenarios label+label{border-left:1px solid var(--line,#d1dbd5)}.ds-scenarios input:checked+span{background:var(--green-soft,#e2eee7);color:var(--forest,#154c3b);font-weight:600}.ds-scenarios input:focus-visible+span{outline:3px solid var(--water,#17659b);outline-offset:-3px}@media(max-width:1050px){.ds-scenarios span{padding:11px 12px;font-size:12px}}@media(max-width:760px){.ds-scenarios{display:grid;grid-template-columns:1fr 1fr;width:100%}.ds-scenarios span{padding:10px 12px;font-size:12px}.ds-scenarios label:nth-of-type(3){border-left:0;border-top:1px solid var(--line,#d1dbd5)}.ds-scenarios label:nth-of-type(4){border-top:1px solid var(--line,#d1dbd5)}}"
    },
    {
      "name": "Synthetic Water Trace",
      "kind": "custom",
      "description": "Source baseline trace, demonstration thresholds, and ruled chart geometry.",
      "html": "<figure class=\"ds-plot\"><svg class=\"ds-chart\" viewBox=\"0 0 680 300\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Six illustrative baseline water readings, not recorded history\"><path class=\"ds-grid\" d=\"M60 48H620 M60 88H620 M60 128H620 M60 168H620 M60 208H620 M60 248H620\" vector-effect=\"non-scaling-stroke\"/><path class=\"ds-area\" d=\"M60 204.8 L172 200 L284 202.4 L396 200 L508 200 L620 200 L620 248 L60 248 Z\"/><path class=\"ds-threshold\" d=\"M60 188H620 M60 152H620\" vector-effect=\"non-scaling-stroke\"/><path class=\"ds-line\" d=\"M60 204.8 L172 200 L284 202.4 L396 200 L508 200 L620 200\" vector-effect=\"non-scaling-stroke\"/><circle class=\"ds-dot\" cx=\"620\" cy=\"200\" r=\"4\" vector-effect=\"non-scaling-stroke\"/></svg><figcaption>Illustrative 25-minute series, not recorded history. Demo thresholds: 1.5 m / 2.4 m.</figcaption></figure>",
