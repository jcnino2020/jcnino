# ==============================================================================
# Telegram AI Auto-Reply System — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your secrets. Never commit `.env`.

# --- Routing & Domain ---
# Use "/tg" when served at https://jcnino.dev/tg
# Use "" (empty) when served at https://tg.jcnino.dev
BASE_PATH=/tg
APP_HOST=127.0.0.1
APP_PORT=8080
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Security & Authentication ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-32-byte-random-secret
# Generate Fernet key for encrypting Telethon StringSession at rest:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-with-fernet-key
# Admin login password hash (generated via scripts/init_db.py --set-password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional TOTP 2FA secret (Base32). Leave blank to disable 2FA.
ADMIN_TOTP_SECRET=
# Set to true when served behind HTTPS (production)
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200

# --- Cloudflare Access (Recommended Defense-in-Depth) ---
# Set to true when Cloudflare Access protects /tg on jcnino.dev
REQUIRE_CLOUDFLARE_ACCESS=false
# Optional: your Cloudflare Access team domain & AUD tag for JWT verification
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Telegram User Account (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Google Gemini Free Tier (aistudio.google.com) ---
# IMPORTANT: Use a Google Cloud project with NO billing account linked ($0 guaranteed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative compatible endpoint (must be genuinely free; no paid fallback)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# --- Permanent Free-Tier Quota Guards (Soft App Limits) ---
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=150000
RPM_LIMIT=10
QUOTA_WARN_PERCENT=80

# --- Storage & Logging ---
DB_PATH=./data/tg_autoreply.db
BACKUP_DIR=./data/backups
LOG_LEVEL=INFO
DRY_RUN=true
