[Unit]
Description=Telegram AI Auto-Reply Service (Single Worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tg-auto-reply
EnvironmentFile=/opt/tg-auto-reply/.env
# IMPORTANT: Always keep --workers 1 so only ONE Telethon listener runs.
ExecStart=/opt/tg-auto-reply/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/tg-auto-reply/data

[Install]
WantedBy=multi-user.target
