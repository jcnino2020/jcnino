      "html": "<div class=\"ds-overflow\"><span>32-bit interpreted date</span><time>1901-12-13 20:45:52 UTC</time></div>",
      "css": ".ds-overflow{font-family:var(--body,\"IBM Plex Sans\",sans-serif);letter-spacing:0;background:var(--danger-soft,#fae7e4);padding:20px 24px;color:var(--danger,#a83236)}.ds-overflow span{display:block;font-size:13px;color:var(--muted,#63616e);margin-bottom:8px}.ds-overflow time{display:block;font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-size:15px;overflow-wrap:anywhere;transition:background-color 160ms ease-out,color 160ms ease-out}@media(prefers-reduced-motion:reduce){.ds-overflow time{transition:none}}"
    }
