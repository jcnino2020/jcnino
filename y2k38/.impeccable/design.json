    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Plum rail with a light active route and four-track mobile navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Y2K38 preview\"><a href=\"#overview\" aria-current=\"page\">Overview</a><a href=\"#simulator\">Simulator</a><a href=\"#history\">History</a><a href=\"#fix\">64-bit fix</a></nav>",
      "css": ".ds-nav{font-family:var(--body,\"IBM Plex Sans\",sans-serif);letter-spacing:0;background:var(--plum,#3d294e);padding:20px;width:172px;display:grid;gap:8px}.ds-nav a{padding:12px;color:#e0d6e8;text-decoration:none;border-radius:var(--radius,4px);font-size:15px;min-height:24px;display:flex;align-items:center}.ds-nav a:hover{background:#503a62;color:#fff}.ds-nav a[aria-current=page]{background:#f4f5f6;color:#3d294e;font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--teal,#086d64);outline-offset:4px;}@media(max-width:760px){.ds-nav{width:auto;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}.ds-nav a{padding:9px 4px;justify-content:center;font-size:12px;min-height:26px}}"
    },
    {
      "name": "Instrument Container",
      "kind": "card",
      "refersTo": "instrument",
      "description": "The genuinely framed working tool; reading sections remain unframed.",
      "html": "<section class=\"ds-instrument\"><header><h2>Signed 32-bit time</h2><span>Within signed 32-bit range</span></header><div class=\"ds-instrument-body\"><p>Both representations preserve these seconds.</p></div><footer>Two&#39;s-complement wrap model</footer></section>",
      "css": ".ds-instrument{font-family:var(--body,\"IBM Plex Sans\",sans-serif);letter-spacing:0;background:var(--surface,#fff);color:var(--ink,#252331);border:1px solid var(--line,#d8d8df);border-radius:var(--radius,4px);overflow:hidden}.ds-instrument header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:18px 24px;border-bottom:1px solid var(--line,#d8d8df)}.ds-instrument h2{font-family:var(--display,\"Space Grotesk\",sans-serif);font-size:20px;line-height:1.15;letter-spacing:0;margin:0}.ds-instrument header span{font-size:13px;font-weight:600;color:var(--teal,#086d64)}.ds-instrument-body{padding:24px}.ds-instrument-body p{font-size:14px;color:var(--muted,#63616e);margin:0}.ds-instrument footer{padding:16px 24px;border-top:1px solid var(--line,#d8d8df);font-size:13px;color:var(--muted,#63616e)}"
    },
    {
      "name": "Binary Register Cells",
      "kind": "custom",
      "refersTo": "bit-active",
      "description": "Real data cells, showing sign and value-bit states. This preview is a static representative excerpt, not the application engine.",
      "html": "<div class=\"ds-bits\" role=\"group\" aria-label=\"Representative register cells\"><button class=\"ds-bit ds-sign\" aria-label=\"Sign bit 31\" aria-pressed=\"false\"><span>0</span><small>31</small></button><button class=\"ds-bit ds-on\" aria-label=\"Bit 30\" aria-pressed=\"true\"><span>1</span><small>30</small></button><button class=\"ds-bit ds-on\" aria-label=\"Bit 29\" aria-pressed=\"true\"><span>1</span><small>29</small></button><button class=\"ds-bit\" aria-label=\"Bit 28\" aria-pressed=\"false\"><span>0</span><small>28</small></button></div>",
      "css": ".ds-bits{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:3px;max-width:240px}.ds-bit{min-width:0;border:0;border-radius:2px;padding:12px 0 6px;background:var(--soft,#eae8ef);color:var(--muted,#63616e);display:grid;gap:7px;min-height:66px;align-content:center;font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-size:16px;cursor:pointer}.ds-bit small{font-size:9px}.ds-on{background:var(--teal-soft,#dcefeb);color:var(--teal,#086d64)}.ds-sign{background:var(--danger-soft,#fae7e4);color:var(--danger,#a83236)}.ds-sign[aria-pressed=true]{background:var(--danger,#a83236);color:var(--surface,#fff)}.ds-bit:hover{outline:2px solid var(--accent,#654184);outline-offset:-2px}.ds-bit:focus-visible{outline:3px solid var(--teal,#086d64);outline-offset:4px;}"
    },
    {
      "name": "Overflow Date Readout",
