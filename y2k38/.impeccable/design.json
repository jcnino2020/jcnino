      "css": ".ds-field{font-family:var(--body,\"IBM Plex Sans\",sans-serif);letter-spacing:0;max-width:420px;color:var(--ink,#252331)}.ds-field label{display:block;font-size:13px;color:var(--muted,#63616e);margin-bottom:8px}.ds-field input{width:calc(100% - 26px);font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-size:21px;background:var(--paper,#f4f5f6);border:1px solid var(--line,#d8d8df);border-radius:var(--radius,4px);color:var(--ink,#252331);padding:12px;caret-color:var(--accent,#654184)}.ds-field input:focus-visible{outline:3px solid var(--teal,#086d64);outline-offset:4px;}.ds-field input[aria-invalid=true]{border-color:var(--danger,#a83236)}"
